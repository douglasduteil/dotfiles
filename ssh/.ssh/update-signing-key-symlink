#!/usr/bin/env bash
# Match-exec helper (see ssh/.ssh/config) -- picks the resident FIDO2 key
# handle file matching whichever physical YubiKey is plugged in right now,
# and points git_signing_key_active at it. Runs before auth, no touch
# required: `ykman list` only enumerates USB, it doesn't talk to the FIDO2
# applet.
#
# Why this exists instead of listing both IdentityFiles unconditionally:
# ssh offers every configured IdentityFile it can read a public key from,
# even ones whose hardware isn't attached, and OpenSSH only detects that a
# key is absent/wrong by asking for a touch+PIN and having it fail. With
# both keys always listed, the wrong one gets tried (and touched) first
# every time the "other" YubiKey is the one physically present.
set -euo pipefail

serial="$(ykman list --serials 2>/dev/null | head -n1)"

case "$serial" in
  25938082) target=git_signing_key_Y5C-alpha-25938082 ;;
  36628851) target=git_signing_key_Y5C-beta-36628851 ;;
  *) exit 0 ;; # no known key detected -- leave symlink as last set
esac

ln -sf "$target" ~/.ssh/git_signing_key_active
