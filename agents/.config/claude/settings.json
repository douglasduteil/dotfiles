{
  "env": {
    "SSH_ASKPASS_REQUIRE": "force"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(//home/nixos/.cache/agents/memory/**)",
      "Read(//home/nixos/.dotfiles/.agents/memory/**)",
      "Edit(//home/nixos/.cache/agents/memory/**)",
      "Edit(//home/nixos/.dotfiles/.agents/memory/**)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.dotfiles/x-memory/src/hooks/claude-code-session-start.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": false
}
