{
  "env": {
    "SSH_ASKPASS_REQUIRE": "force",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(//home/nixos/.cache/agents/memory/**)",
      "Read(//home/nixos/.dotfiles/.agents/memory/**)",
      "Edit(//home/nixos/.cache/agents/memory/**)",
      "Edit(//home/nixos/.dotfiles/.agents/memory/**)"
    ]
  },
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "x-memory hook claude-code SessionStart",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": false
}
