{
  "env": {
    "SSH_ASKPASS_REQUIRE": "force",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read(//home/nixos/.local/share/agents/x-memory/**)",
      "Read(//home/nixos/.config/agents/x-memory/**)",
      "Read(//home/nixos/.dotfiles/.agents/x-memory/**)",
      "Read(//home/nixos/.dotfiles/agents/.config/agents/x-memory/**)",
      "Edit(//home/nixos/.local/share/agents/x-memory/**)",
      "Edit(//home/nixos/.config/agents/x-memory/**)",
      "Edit(//home/nixos/.dotfiles/.agents/x-memory/**)",
      "Edit(//home/nixos/.dotfiles/agents/.config/agents/x-memory/**)"
    ],
    "deny": [
      "Read(**/.env*.local)",
      "Edit(**/.env*.local)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/age/**)",
      "Edit(~/.config/sops/age/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/claude/settings.json)",
      "Edit(~/.dotfiles/agents/.config/claude/settings.json)",
      "Edit(~/.dotfiles/agents/.config/opencode/opencode.jsonc)",
      "Edit(~/.dotfiles/omp/.config/omp/agent/config.yml)",
      "Edit(~/.dotfiles/omp/.config/omp/agent/hooks/pre/x-guard.ts)",
      "Edit(~/.config/opencode/opencode.jsonc)",
      "Edit(~/.config/omp/agent/config.yml)",
      "Edit(~/.config/omp/agent/hooks/pre/x-guard.ts)",
      "Edit(~/.omp/agent/config.yml)",
      "Edit(~/.omp/agent/hooks/pre/x-guard.ts)",
      "Edit(~/.config/agents/rules/constitution.md)",
      "Edit(~/.dotfiles/agents/.config/agents/rules/constitution.md)",
      "Bash(sops:*)",
      "Bash(find / *)",
      "Bash(gh auth token:*)",
      "Bash(gh auth status --show-token:*)",
      "Bash(git credential:*)",
      "Bash(ssh-agent:*)",
      "Bash(ssh-keygen -y:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "haiku",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.config/opencode/plugins/x-jev.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "x-memory hook claude-code SessionStart",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "askUserQuestionTimeout": "never",
  "remote": {
    "defaultEnvironmentId": "env_016P1diZS11ymnkFd352sPei"
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
