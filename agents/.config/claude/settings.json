{
  "env": {
    "SSH_ASKPASS_REQUIRE": "force",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read(//home/nixos/.cache/agents/memory/**)",
      "Read(//home/nixos/.dotfiles/.agents/memory/**)",
      "Edit(//home/nixos/.cache/agents/memory/**)",
      "Edit(//home/nixos/.dotfiles/.agents/memory/**)"
    ],
    "deny": [
      "Read(**/.env*.local)",
      "Edit(**/.env*.local)",
      "Bash(sops:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "x-memory hook claude-code SessionStart",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "remote": {
    "defaultEnvironmentId": "env_016P1diZS11ymnkFd352sPei"
  }
}
