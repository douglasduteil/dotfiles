{
  "$schema": "https://opencode.ai/config.json",
  "env": {
    "SSH_ASKPASS_REQUIRE": "force"
  },
  "share": "disabled",
  // Explicit so sharing doesn't quietly depend on the ~/.claude symlink
  // (that symlink's own purpose is unrelated legacy-path compat).
  // Plugin paths point at the plugin's parent dir, one level above the
  // version/hash-pinned subdir, so a `claude plugin update` can't break
  // this -- opencode's skill loader scans recursively for **/SKILL.md.
  "skills": {
    "paths": [
      "~/.config/agents/skills",
      "~/.config/claude/plugins/cache/claude-plugins-official/mattpocock-skills",
      "~/.config/claude/plugins/cache/ponytail/ponytail",
      "~/.config/claude/plugins/cache/caveman/caveman"
    ]
  },
  "permission": {
    "read": { "**/.env*.local": "deny", "$HOME/.config/sops/age/**": "deny" },
    "edit": { "**/.env*.local": "deny", "$HOME/.config/sops/age/**": "deny" },
    "bash": { "sops*": "deny", "find / *": "deny" },
    "external_directory": {
      "~/.cache/agents/memory/**": "allow",
      "$HOME/.dotfiles/.agents/memory/**": "allow"
    }
  }
}
