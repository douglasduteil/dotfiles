{
  "$schema": "https://opencode.ai/config.json",
  "env": {
    "SSH_ASKPASS_REQUIRE": "force"
  },
  "instructions": ["~/.config/agents/rules/constitution.md"],
  "share": "disabled",
  // Explicit so sharing doesn't quietly depend on the ~/.claude symlink
  // (that symlink's own purpose is unrelated legacy-path compat).
  // Plugin paths point at the plugin's parent dir, one level above the
  // version/hash-pinned subdir, so a `claude plugin update` can't break
  // this -- opencode's skill loader scans recursively for **/SKILL.md.
  "skills": {
    "paths": [
      "~/.config/agents/skills",
      "~/.config/claude/plugins/cache/claude-plugins-official/mattpocock-skills",
      "~/.config/claude/plugins/cache/ponytail/ponytail",
      "~/.config/claude/plugins/cache/caveman/caveman"
    ]
  },
  "permission": {
    "read": {
      "**/.env*.local": "deny",
      "$HOME/.aws/**": "deny",
      "$HOME/.config/gh/**": "deny",
      "$HOME/.config/sops/age/**": "deny",
      "$HOME/.git-credentials": "deny",
      "$HOME/.gnupg/**": "deny",
      "$HOME/.netrc": "deny",
      "$HOME/.ssh/**": "deny"
    },
    "edit": {
      "**/.env*.local": "deny",
      "$HOME/.config/claude/settings.json": "deny",
      "$HOME/.config/opencode/opencode.jsonc": "deny",
      "$HOME/.config/sops/age/**": "deny",
      "$HOME/.config/agents/rules/constitution.md": "deny",
      "$HOME/.dotfiles/agents/.config/agents/rules/constitution.md": "deny",
      "$HOME/.dotfiles/agents/.config/claude/settings.json": "deny",
      "$HOME/.dotfiles/agents/.config/opencode/opencode.jsonc": "deny",
      "$HOME/.config/omp/agent/config.yml": "deny",
      "$HOME/.config/omp/agent/hooks/pre/x-guard.ts": "deny",
      "$HOME/.dotfiles/omp/.config/omp/agent/config.yml": "deny",
      "$HOME/.dotfiles/omp/.config/omp/agent/hooks/pre/x-guard.ts": "deny",
      "$HOME/.omp/agent/config.yml": "deny",
      "$HOME/.ssh/**": "deny"
    },
    "bash": {
      "*": "ask",
      "*--show-token*": "deny",
      "*.ssh*": "deny",
      "*hosts.yml*": "deny",
      "find / *": "deny",
      "gh auth token*": "deny",
      "git credential*": "deny",
      "sops*": "deny",
      "ssh-add*": "deny",
      "ssh-agent*": "deny"
    },
    "external_directory": {
      "~/.local/share/agents/x-memory/**": "allow",
      "~/.config/agents/x-memory/**": "allow",
      "$HOME/.dotfiles/agents/.config/agents/x-memory/**": "allow",
      "$HOME/.dotfiles/.agents/x-memory/**": "allow"
    }
  }
}
